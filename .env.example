# Copy values to local .dev.vars or configure through Cloudflare.
# Never commit real passwords, API keys, setup keys, or credentials.
ADMIN_EMAIL=owner@example.com
ADMIN_SETUP_KEY=
# Password reset email: keep RESEND_API_KEY in Cloudflare Secrets.
# Public production values are also tracked in wrangler.jsonc.
RESEND_API_KEY=
EMAIL_FROM=eConect <noreply@econectapp.com>
APP_ORIGIN=https://econectapp.com
# Optional: add the LIVE Paystack secret as a Cloudflare Secret, never commit a real key.
PAYSTACK_SECRET_KEY=
