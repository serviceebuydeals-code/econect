# Copy values to local .dev.vars or configure through Cloudflare.
# Never commit real passwords, API keys, setup keys, or credentials.
ADMIN_EMAIL=owner@example.com
ADMIN_SETUP_KEY=
# Password reset email: keep RESEND_API_KEY in Cloudflare Secrets.
# Public production values are also tracked in wrangler.jsonc.
RESEND_API_KEY=
EMAIL_FROM=eConect <noreply@econectapp.com>
APP_ORIGIN=https://econectapp.com
# Optional: add the LIVE Paystack secret as a Cloudflare Secret, never commit a real key.
PAYSTACK_SECRET_KEY=

# Admin Mail receiving: Resend webhook signing secret (whsec_...), never commit a value.
# Resend webhook URL: https://econectapp.com/api/mail/webhook; event: email.received
RESEND_WEBHOOK_SECRET=

# Cloudflare business mail uses the MAIL_SEND send_email binding in wrangler.jsonc.
# Route support@econectapp.com to Worker "econect" in Cloudflare Email Routing.
# Arbitrary-recipient sends require Email Sending domain onboarding and Workers Paid.
# RESEND_WEBHOOK_SECRET is optional when using Cloudflare receiving.
