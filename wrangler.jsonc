{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "econect",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/tv/*",
      "/shop/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "econect-db",
      "database_id": "8ba20d8d-b2c9-4801-a3fd-c87746403312",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "econect-media"
    }
  ],
  "keep_vars": true,
  "vars": {
    "STREAM_ACCOUNT_ID": "143eedba9d8f1ec442c0ec8d3191330f"
  }
}
